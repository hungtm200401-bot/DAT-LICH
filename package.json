{
  "name": "hoan-makeup-booking-admin",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-verified.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/project.test.mjs tests/cms.test.mjs tests/location.test.mjs tests/device-position.test.mjs tests/address-details.test.mjs tests/finance.test.mjs tests/overview.test.mjs tests/maps-config.test.mjs tests/address-search.test.mjs tests/admin-location.test.mjs tests/map-tiles.test.mjs tests/public-routes.test.mjs tests/vietnam-date.test.mjs tests/security.test.mjs tests/visitor-session-codes.test.mjs",
    "test:overview": "node --test tests/overview.test.mjs",
    "verify:business-data": "node scripts/verify-business-data.mjs",
    "verify:booking-otp": "node scripts/verify-booking-otp.mjs",
    "verify:booking-google": "node scripts/verify-booking-google.mjs",
    "preview:booking-otp": "node scripts/verify-booking-otp.mjs --preview",
    "verify:overview": "node scripts/verify-overview.mjs",
    "verify:overview-version": "node scripts/verify-overview-version.mjs",
    "verify:openfreemap": "node scripts/verify-vector-map.mjs && node scripts/verify-admin-location-lazy.mjs && node scripts/verify-maps-settings.mjs",
    "verify:booking-address": "node scripts/verify-booking-address.mjs && node scripts/verify-booking-worker.mjs",
    "test:cms": "node --test tests/cms.test.mjs",
    "verify:cms": "node scripts/verify-cms-expansion.mjs",
    "verify:map": "node scripts/verify-vector-map.mjs",
    "verify:location-loading": "node scripts/verify-booking-address.mjs",
    "verify:cms-api": "node scripts/verify-cms-api.mjs",
    "verify:content-ui": "node scripts/verify-content-usability.mjs",
    "verify:admin-ui": "node scripts/verify-admin-interface.mjs",
    "verify:editor-layout": "node scripts/verify-editor-layout.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "db:backup:local": "node scripts/local-d1-backup.mjs backup",
    "tunnel": ".\\cloudflared.exe tunnel --url http://127.0.0.1:5173"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@block65/webcrypto-web-push": "2.0.0",
